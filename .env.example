# =============================================================================
# MV Payment Approval System - Environment Configuration Template
# Copy this file to .env and replace placeholder values with secure credentials.
# NOTE: Do NOT commit your actual .env file with real secrets to source control.
# =============================================================================

# =============================================================================
# 1. APPLICATION ENVIRONMENT & GENERAL SETTINGS
# =============================================================================
# Application environment mode: 'production', 'staging', or 'development'
APP_ENV=production
ENVIRONMENT=production

# Human-readable name of the application displayed across UI and emails
APP_NAME="MV Payment Approval System"

# Public fully qualified domain URL for frontend access (without trailing slash)
APP_URL=https://payment.example.com

# Backend API server listening port (internal Docker or local dev)
PORT=8000

# Gateway HTTP/HTTPS ports mapped on host machine
HTTP_PORT=80
HTTPS_PORT=443

# Cryptographic master secret key used for session signing and internal hashing
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string

# Enable debug mode (MUST be false in production)
DEBUG=false

# Logging verbosity: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL=INFO

# =============================================================================
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# =============================================================================
# Hostname of the PostgreSQL server ('postgres' when running in docker-compose, 'localhost' for local)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mv_payment
POSTGRES_USER=mv_admin
# Strong database password (alphanumeric + symbols, min 16 characters)
POSTGRES_PASSWORD=replace_with_strong_database_password_16_chars

# Asynchronous connection string for SQLAlchemy asyncpg
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://mv_admin:replace_with_strong_database_password_16_chars@postgres:5432/mv_payment

# Database connection pool settings for high throughput
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30

# =============================================================================
# 3. CACHE & MESSAGE BROKER (Redis 7)
# =============================================================================
# Hostname of the Redis server ('redis' in docker-compose, 'localhost' for local)
REDIS_HOST=redis
REDIS_PORT=6379
# Strong Redis authentication password
REDIS_PASSWORD=replace_with_strong_redis_password_16_chars
REDIS_DB=0

# Redis connection URL
# Format: redis://:<password>@<host>:<port>/<db>
REDIS_URL=redis://:replace_with_strong_redis_password_16_chars@redis:6379/0

# =============================================================================
# 4. AUTHENTICATION & JWT (JSON Web Tokens)
# =============================================================================
# Secret key used for signing JSON Web Tokens (HMAC-SHA256)
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-another-secure-random-64-character-hex-key
JWT_SECRET_KEY=change-this-to-another-secure-random-64-character-hex-key

# JWT signing algorithm (HS256 recommended for symmetric key)
JWT_ALGORITHM=HS256

# Access token lifespan in minutes (recommended: 15 to 30 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifespan in days (recommended: 7 to 14 days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password reset token expiration window in minutes
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# =============================================================================
# 5. SECURITY, CORS & RATE LIMITING
# =============================================================================
# Comma-separated list of allowed CORS origins for browser security
ALLOWED_ORIGINS="https://payment.example.com,http://localhost:3000"
CORS_ORIGINS="https://payment.example.com,http://localhost:3000"

# Allow credentials (cookies, authorization headers) across CORS requests
CORS_ALLOW_CREDENTIALS=true

# Global API rate limit: maximum requests allowed per minute per client IP
RATE_LIMIT_PER_MINUTE=120

# Strict authentication rate limit for login/password endpoints per minute
AUTH_RATE_LIMIT_PER_MINUTE=10

# Enforce Multi-Factor Authentication (MFA / TOTP) across all approval roles
TWO_FACTOR_AUTHENTICATION_REQUIRED=true

# =============================================================================
# 6. SMTP / TRANSACTIONAL EMAIL CONFIGURATION
# =============================================================================
# Outbound SMTP server hostname (e.g., smtp.sendgrid.net, smtp.mailgun.org, or corporate relay)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@mg.example.com
SMTP_PASSWORD=replace_with_smtp_auth_password
SMTP_TLS=true
SMTP_SSL=false

# Sender address and display name for notifications and approval requests
EMAILS_FROM_EMAIL=notifications@payment.example.com
SMTP_FROM=notifications@payment.example.com
EMAILS_FROM_NAME="MV Payment Approval System"

# =============================================================================
# 7. DOCUMENT UPLOADS & ATTACHMENT STORAGE
# =============================================================================
# Local filesystem directory where payment invoices and receipts are stored
UPLOAD_DIR=/app/uploads

# Maximum allowed file upload size in bytes (10485760 bytes = 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_UPLOAD_SIZE=10485760

# Whitelisted file extensions permitted for document uploads (comma-separated)
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,csv,xlsx

# =============================================================================
# 8. PAYMENT & APPROVAL WORKFLOW BUSINESS RULES
# =============================================================================
# Default currency ISO 4217 code
DEFAULT_CURRENCY=USD

# Maximum hours an approval can remain pending before automated manager escalation
AUTO_ESCALATION_HOURS=24

# Number of days to retain tamper-evident audit logs before archiving
AUDIT_LOG_RETENTION_DAYS=2555

# Approval threshold tier levels in base currency (USD)
TIER_1_LIMIT=5000.00
TIER_2_LIMIT=25000.00
TIER_3_LIMIT=100000.00

# =============================================================================
# 9. FRONTEND (Vite / React) ENVIRONMENT VARIABLES
# =============================================================================
# API base URL path consumed by frontend client
VITE_API_URL=/api/v1

# Application title displayed in the browser tab and PWA header
VITE_APP_TITLE="MV Payment Approval"

# Toggle Progressive Web App service worker registration
VITE_ENABLE_PWA=true

# =============================================================================
# 10. INITIAL SYSTEM PROVISIONING / SUPERADMIN SEED
# =============================================================================
# Seed credentials used only during initial database bootstrap migration
FIRST_SUPERADMIN_EMAIL=admin@example.com
FIRST_SUPERADMIN_PASSWORD=replace_with_temporary_initial_admin_password_16_chars
FIRST_SUPERADMIN_NAME="System Administrator"
# Secret required by the /setup page (POST /api/setup/init). Mandatory in production.
SETUP_TOKEN=replace_with_random_setup_token
