# ==============================================================================
# MV Payment Approval System - Backend Environment Configuration Template
# Copy this file to '.env' and adjust the values according to your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application Metadata & Environment
APP_NAME="MV Payment Approval"
APP_URL="http://localhost:3000"
ENVIRONMENT="development"  # Options: development, staging, production

# PostgreSQL Database Configuration
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mv_payment_db"

# Security & JWT Token Encryption Keys
# Generate random 32+ character keys in production (e.g., openssl rand -hex 32)
SECRET_KEY="mv-payment-approval-super-secret-key-change-in-production-min-32-chars"
JWT_SECRET_KEY="mv-payment-approval-jwt-secret-key-change-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array or comma-separated strings)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# File Storage Configuration (Private storage, never public/static)
UPLOAD_DIR="d:/mv-payment-approval/uploads"
# Maximum upload size in bytes (10485760 bytes = 10MB)
MAX_UPLOAD_SIZE=10485760
# Permitted file extensions (comma-separated or JSON array)
ALLOWED_EXTENSIONS="pdf,jpg,jpeg,png,xlsx"

# SMTP Email Notification Service
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@mvpayment.com"

# Redis Cache & Celery Message Broker (Optional / Background Tasks)
REDIS_URL="redis://localhost:6379/0"
