# =============================================================================
# MV Payment Approval System - Git Ignore Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets (NEVER COMMIT SENSITIVE SECRETS)
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Cryptographic Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.csr
nginx/ssl/*
!nginx/ssl/.gitkeep
nginx/certbot/conf/*
nginx/certbot/www/*
!nginx/certbot/www/.gitkeep

# -----------------------------------------------------------------------------
# Python Artifacts & Virtual Environments
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing, Coverage & Linters
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/
.ruff_cache/

# -----------------------------------------------------------------------------
# Node.js & Frontend Assets
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend Build Outputs
frontend/dist/
frontend/dist-ssr/
frontend/build/
.vite/
.cache/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Document Uploads & Storage
# -----------------------------------------------------------------------------
uploads/*
!uploads/documents/
uploads/documents/*
!uploads/documents/.gitkeep
media/

# -----------------------------------------------------------------------------
# Database, Cache & Persistent Data Volumes
# -----------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
postgres_data/
redis_data/
dump.rdb
*.sql
*.sql.gz
backups/

# -----------------------------------------------------------------------------
# Logs & Diagnostic Files
# -----------------------------------------------------------------------------
*.log
logs/
backend/logs/*
!backend/logs/.gitkeep

# -----------------------------------------------------------------------------
# Operating System & IDE Specific
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# Editors & IDEs
.vscode/*
